				{
					"name": "Users - Create 1",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('status 201', ()=>pm.response.to.have.status(201));",
									"",
									"// Save created user1 values to environment",
									"try {",
									"  const json = pm.response.json();",
									"  if (json) {",
									"    if (json.userId) {",
									"      pm.environment.set('user1_id', json.userId);",
									"      pm.environment.set('id', json.userId); // default id = user1",
									"    }",
									"    if (json.phoneNumber) {",
									"      pm.environment.set('user1_phone', json.phoneNumber);",
									"      pm.environment.set('phoneNumber', json.phoneNumber);",
									"    }",
									"    if (json.version !== undefined) {",
									"      pm.environment.set('user1_version', json.version);",
									"    }",
									"    if (json.nickname) { pm.environment.set('user1_nickname', json.nickname); }",
									"    console.log('✅ Saved user1 vars:', { id: pm.environment.get('user1_id'), phone: pm.environment.get('user1_phone') });",
									"  }",
									"} catch (e) { console.log('⚠️ Failed to parse create user1 response', e); }"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
